# ============================================================
# INGESTA (Reporte Diario de Producción) — Plantilla de entorno
# ------------------------------------------------------------
# Copiar a ".env" y dejar activo UN solo bloque (dev o prod).
# El backend FastAPI usa SOLO la variable DATABASE_URL.
# Las PG* son para herramientas CLI (psql / pg_dump).
# NO poner secretos reales aquí (este archivo SÍ se versiona).
# ============================================================

# ------------------------------------------------------------
# DESARROLLO — PostgreSQL LOCAL
# Requiere restaurar el dump (data/DB dump/) en una BD local.
# Si el password trae signos especiales, va percent-encoded en
# la URL (ej. '£' -> %C2%A3).
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD_ENCODED@localhost:5432/daily_report_prod?sslmode=disable
PGHOST=localhost
PGPORT=5432
PGDATABASE=daily_report_prod
PGUSER=USUARIO
PGPASSWORD=

# ------------------------------------------------------------
# PRODUCCIÓN — servidor 139 (descomentar y comentar el de arriba)
# Si el servicio corre EN la 139, usar host localhost.
# Si corre en otra máquina, usar 10.100.26.139 (requiere red/VPN).
# ------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD_ENCODED@10.100.26.139:5432/daily_report_prod?sslmode=disable
# PGHOST=10.100.26.139
# PGPORT=5432
# PGDATABASE=daily_report_prod
# PGUSER=USUARIO
# PGPASSWORD=
